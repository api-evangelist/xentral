{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Reporting Settings API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reporting Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/analytics/settings"
          },
          "docs": "Returns current settings or default settings if none exist"
        },
        {
          "info": {
            "name": "Update reporting settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{xentralId}.xentral.biz/api/v1/analytics/settings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the current settings"
        }
      ]
    }
  ],
  "bundled": true
}