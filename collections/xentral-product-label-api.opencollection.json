              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Downloads a product label for the given product as pdf."
        },
        {
          "info": {
            "name": "Print product label",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/products/:id/printLabel",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Prints a product label for the given product."
        }
      ]
    }
  ],
  "bundled": true
