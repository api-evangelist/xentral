{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Supplier Tag API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Supplier Tag",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List suppliers tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/suppliersTags"
          },
          "docs": "Returns a collection with all suppliers tags."
        }
      ]
    }
  ],
  "bundled": true
}