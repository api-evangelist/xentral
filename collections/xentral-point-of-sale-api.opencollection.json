{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Point Of Sale API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Point Of Sale",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List cashiers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/cashiers",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Lists all active cashiers."
        },
        {
          "info": {
            "name": "Cashier PIN check",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/cashiers/:id/pinCheck",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Checks a pin for cashier."
        },
        {
          "info": {
            "name": "View cash register balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/cashRegisters/:id/balance",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Retrieves the balance of a cash register."
        },
        {
          "info": {
            "name": "List POS journals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/posJournals",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists all active POS journals."
        },
        {
          "info": {
            "name": "Add journal entry",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/posJournals/actions/add",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new journal entry."
        },
        {
          "info": {
            "name": "Add cash count entry",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/posCashCount/actions/add",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new cash count entry."
        },
        {
          "info": {
            "name": "Add qr code data to a document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/posQrCode/actions/add",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add qr code data to a document."
        }
      ]
    }
  ],
  "bundled": true
}