{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Delivery Note API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Delivery Note",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List delivery notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/deliveryNotes",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all delivery notes with pagination and filtering options."
        },
        {
          "info": {
            "name": "View delivery note",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/deliveryNotes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Returns details of a delivery note"
        },
        {
          "info": {
            "name": "List delivery note deliveries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/deliveryNotes/:id/deliveries",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Details of delivery note"
        },
        {
          "info": {
            "name": "View delivery note shipments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/deliveryNotes/:id/shipments",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Details of delivery note shipments"
        },
        {
          "info": {
            "name": "Update delivery note positions customs data.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{xentralId}.xentral.biz/api/v1/deliveryNotes/:id/customsUpdate",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update delivery note positions customs data. \n\n**Attention**: ⚠️ \n\n-  This is an interims endpoint that will be _**deprecated and removed**_ in future. \n\n- We will inform all users of this endpoint about the deprecation and removal before."
        },
        {
          "info": {
            "name": "Assign quality control attributes to delivery note",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{xentralId}.xentral.biz/api/v1/deliveryNotes/:id/actions/assignQualityControlAttributes",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Assign quality control attributes to a delivery note."
        }
      ]
    }
  ],
  "bundled": true
}