              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Provides a list of contact persons belongs to a customer related to given filters"
        },
        {
          "info": {
            "name": "Create contact person",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/customers/:customerId/contactPerson",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "The customer's identifier."
              }
