              {
                "name": "contactPersonId",
                "value": "",
                "type": "path",
                "description": "Contact Person ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates new contact person for given customer."
        },
        {
          "info": {
            "name": "Delete contact person",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{xentralId}.xentral.biz/api/v1/customers/:customerId/contactPerson/:contactPersonId",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the customer"
