            "name": "View return document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/returns/:id/documents/:documentId",
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path",
                "description": "ID of document"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
