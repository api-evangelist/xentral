{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Product Property API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
