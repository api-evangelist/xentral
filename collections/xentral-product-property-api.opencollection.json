            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/productsProperties",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates new products properties."
        },
        {
          "info": {
            "name": "Update multiple product properties",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{xentralId}.xentral.biz/api/v1/productsProperties",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates multiple products properties."
        },
        {
          "info": {
            "name": "Delete multiple product properties",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{xentralId}.xentral.biz/api/v1/productsProperties",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes multiple products properties."
        }
      ]
    }
  ],
  "bundled": true
}