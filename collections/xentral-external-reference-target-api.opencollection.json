{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account External Reference Target API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "External Reference Target",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List external reference targets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/externalReferenceTargets"
          },
          "docs": "Returns a collection with all External Reference Targets."
        }
      ]
    }
  ],
  "bundled": true
}