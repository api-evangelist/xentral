{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Storage Item API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Storage Item",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List storage items V1",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/warehouses/:warehouseId/storageLocations/:storageLocationId/items",
            "params": [
              {
                "name": "warehouseId",
                "value": "",
                "type": "path",
                "description": "ID of warehouse"
              },
              {
                "name": "storageLocationId",
                "value": "",
                "type": "path",
                "description": "ID of storage location"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all storage location items for the specified warehouse / location. If no Accept header is provided, or if Accept: application/json is specified, the response format is identical to version 2."
        },
        {
          "info": {
            "name": "Add item to storage location",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/warehouses/:warehouseId/storageLocations/:storageLocationId/items",
            "params": [
              {
                "name": "warehouseId",
                "value": "",
                "type": "path",
                "description": "ID of warehouse"
              },
              {
                "name": "storageLocationId",
                "value": "",
                "type": "path",
                "description": "ID of storage location"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds stock for a given item to a specific Storage Location."
        },
        {
          "info": {
            "name": "Retrieve item from storage location",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{xentralId}.xentral.biz/api/v1/warehouses/:warehouseId/storageLocations/:storageLocationId/items",
            "params": [
              {
                "name": "warehouseId",
                "value": "",
                "type": "path",
                "description": "ID of warehouse"
              },
              {
                "name": "storageLocationId",
                "value": "",
                "type": "path",
                "description": "ID of storage location"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves certain units of stock for a given item from a specific Storage Location."
        },
        {
          "info": {
            "name": "List storage items V2",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v2/warehouses/:warehouseId/storageLocations/:storageLocationId/items",
            "params": [
              {
                "name": "warehouseId",
                "value": "",
                "type": "path",
                "description": "ID of warehouse"
              },
              {
                "name": "storageLocationId",
                "value": "",
                "type": "path",
                "description": "ID of storage location"
              }
            ]
          },
          "docs": "Returns all storage location items for the specified warehouse / location."
        }
      ]
    }
  ],
  "bundled": true
}