{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Liability API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Liability",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List liabilities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/liabilities",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a collection with all Liabilities"
        },
        {
          "info": {
            "name": "Create liability",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/liabilities",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a single new liability."
        },
        {
          "info": {
            "name": "Create recurring liability",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/liabilities-recurring",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a single new recurring liability."
        },
        {
          "info": {
            "name": "View liability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/liabilities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Returns details of a single liability."
        },
        {
          "info": {
            "name": "Release liability",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{xentralId}.xentral.biz/api/v1/liabilities/:id/actions/release",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Releases the liability, setting its status to released and enabling write protection"
        },
        {
          "info": {
            "name": "Add file to liability",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/liabilities/:id/documents",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload a file and adds this file as document to given liability"
        }
      ]
    }
  ],
  "bundled": true
}