{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xentral Account Collection API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collection",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/analytics/collection"
          },
          "docs": "Returns a list of report collections (official Xentral collections and custom collections)."
        },
        {
          "info": {
            "name": "Create collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{xentralId}.xentral.biz/api/v1/analytics/collection",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new collection and returns the new record"
        },
        {
          "info": {
            "name": "View collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{xentralId}.xentral.biz/api/v1/analytics/collection/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Returns a single collections by ID."
        },
        {
          "info": {
            "name": "Update collection",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{xentralId}.xentral.biz/api/v1/analytics/collection/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing collection specified by its ID and returns the new record"
        },
        {
          "info": {
            "name": "Delete collection",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{xentralId}.xentral.biz/api/v1/analytics/collection/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource's identifier."
              }
            ]
          },
          "docs": "Deletes an existing collection specified by its ID and returns the deleted record"
        }
      ]
    }
  ],
  "bundled": true
}